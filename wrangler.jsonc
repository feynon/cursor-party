{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cursor-party",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/parties/*", "/party/*", "/health"]
  },
  "durable_objects": {
    "bindings": [{ "name": "Main", "class_name": "PresenceServer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PresenceServer"] }],
  "vars": {
    "WEBSITES": "[\"https://ankeshbharti.com/*\",\"https://www.ankeshbharti.com/*\"]"
  }
}
